# Copy to .env next to docker-compose.yml and edit. .env is gitignored, so it
# survives deploy.sh (which does a hard reset on the checkout).

# Public URL users actually reach. Required for MCP OAuth — see
# docs/manual/10-mcp-agent-access.md. No trailing slash.
MEMOS_INSTANCE_URL=https://toucan.huzhi.dev

# Host port the container publishes on. The reverse proxy points here.
MEMOS_PORT=5230

TZ=Asia/Shanghai
